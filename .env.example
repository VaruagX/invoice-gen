PORT=8000
NODE_ENV=development
APP_URL=http://localhost:8000
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DATABASE_URL=your-neon-postgres-url
SESSION_SECRET=replace-with-a-long-random-secret

# Optional:
# AUTO_MIGRATE=false          # don't apply migrations on boot; run `npm run migrate` yourself
# DATABASE_POOL_MAX=10
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/invoice_test   # local DB for `npm test` (gets wiped)

# Render production values:
# NODE_ENV=production
# APP_URL=https://invoice-gen-04ry.onrender.com
# GOOGLE_CALLBACK_URL=https://invoice-gen-04ry.onrender.com/auth/google/callback
